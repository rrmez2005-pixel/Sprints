<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trades Job Board</title>
    <link rel="stylesheet" href="styles/styles.css">
    <script src="scripts/script.js" defer></script>

    <!-- DataTable -->
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://cdn.datatables.net/3.1.4/js/dataTables.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/3.1.4/css/dataTables.dataTables.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/4.1.1/css/responsive.dataTables.min.css">
    <script src="https://cdn.datatables.net/responsive/4.1.1/js/dataTables.responsive.min.js"></script>
    
    <!-- Favicon -->
     <link rel="icon" href="images/GRC.png">
</head>
<body>
    <header>
        <div id="header">
            <h1>Green River Trades Job Board</h1>
            <p>Welcome to Green River! This job board is where
            you can find job postings for trades students and graduates. 
            Browse open positions, or add a job if you're an employer looking to hire.</p>
        </div>
    </header>
    <nav>
        <div id="navigation">
             <a href="https://www.greenriver.edu/students/mygreenriver.html">GRC Home</a>
            <a href="/jobs">View Job board</a>
            <a href="/announcements">Announcements</a>
            <a href="/add-job">Add job</a>
        </div>
    </nav>
    <main>
        <div id="main">
            <!-- Job data table goes here -->
             <div class="table-wrap">
                <table id="jobtable" class="display no wrap" style="width:100%">
                    <thead>
                        <tr>
                            <th>Job Title</th>
                            <th>Company</th>
                            <th>Employment</th>
                            <th>Trade</th>
                            <th>Location</th>
                            <th>Date Posted</th>
                            <th>Date Expires</th>
                            <th>Apply</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% jobs.forEach(job => { %>
                        <tr>
                            <td><%= job.jobtitle %></td>
                            <td><%= job.company %></td>
                            <td><%= job.employment %></td>
                            <td><%= job.trade %></td>
                            <td><%= job.location %></td>
                            <td data-order="<%= new Date(job.dateposted).getTime() %>"><%= job.dateposted %></td>
                            <td data-order="<%= new Date(job.dateexpires).getTime() %>"><%= job.dateexpires %></td>
                            <td>
                                <!-- Dynamic EJS link using what the user typed -->
                                <a href="<%= job.applink %>" target="_blank">Apply</a>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <script>
                new DataTable('#jobtable', {

                    responsive:true,

                    language: {
                        emptyTable: 'No jobs available at this time'
                    },
                    columnDefs: [
                        { orderable: false, targets: 7 }
                    ]
                });
            </script>
        </div>
    </main>
</body>
</html>