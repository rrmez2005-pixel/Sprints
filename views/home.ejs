<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GRC Trades Job Board</title>
    
    <!-- Stylesheets -->
    <link rel="stylesheet" href="styles/styles.css">
    <link rel="stylesheet" href="styles/hamburger.css">

    <!-- JavaScript -->
    <script src="scripts/script.js" defer></script>

    <!-- Favicon -->
     <link rel="icon" href="/images/GRC.png">

    <!-- DataTable -->
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://cdn.datatables.net/3.1.4/js/dataTables.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/3.1.4/css/dataTables.dataTables.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/4.1.1/css/responsive.dataTables.min.css">
    <script src="https://cdn.datatables.net/responsive/4.1.1/js/dataTables.responsive.min.js"></script>
</head>
<body>
    <div class="guideNav">
        <!-- hamburger menu partial -->
        <%- include('partials/hamb') %>
        
        <!-- GRC website logo link -->
        <a class="tradesLink" href="https://www.greenriver.edu/students/academics/areas-of-interest/program-maps/trades-industrial-tech-aviation-natural-resources/index.html" target="_blank">
            <img class="GRCimage" src="/images/GRC.png" alt="Green River College Logo">
            <p>GRC Trades</p>
        </a>
    </div>
    <header>
        <div id="header">
            <h1>Green River Trades Job Board</h1>
            <p>Welcome! This job board is where
            you can find job postings for Green River trades students and graduates.</p>
        </div>
    </header>
    <!-- Homepage DataTable -->
    <main>
        <div id="main">
            <!-- Job data table goes here -->
             <div class="table-wrap">
                <!-- Drop down trades filter -->
                <div id="filter">
                    <lable for="trades-filter">Filter:</lable>
                    <select id="trades-filter">
                        <option value="none"> View by Trade</option>
                        <option value="Automotive">Automotive</option>
                        <option value="Carpentry">Carpentry</option>
                        <option value="Manufacturing">Manufacturing</option>
                        <option value="Mechatronics">Mechatronics</option>
                        <option value="Welding">Welding</option>
                    </select>
                </div>
                <table id="jobtable" class="display no wrap" style="width:100%">
                    <thead>
                        <tr>
                            <th>Job Title</th>
                            <th>Company</th>
                            <th>Job Type</th>
                            <th>Employment</th>
                            <th>Trade</th>
                            <th>Location</th>
                            <th>Apply By</th>
                            <th>Apply</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% jobs.forEach(job => { %>
                                <tr>
                                    <td><%= job.jobtitle %></td>
                                    <td><%= job.company %></td>
                                    <td><%= job.job %></td>
                                    <td><%= job.employment %></td>
                                    <td><%= job.trade %></td>
                                    <td><%= job.location %></td>
                                    <td><%= formatDate(job.dateexpires)%></td>
                                    <td data-priority="1">
                                        <!-- Dynamic EJS link using what the user typed -->
                                        <a href="<%= job.applink %>" target="_blank" class="apply">Apply</a>
                                    </td>
                                </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <script>
                //DataTable JS (basically customization)
                new DataTable('#jobtable', {
                    responsive:true,
                    pageLength: 25,
                    lengthChange: false,
                    order: [],
                    language: {
                        emptyTable: 'No jobs available at this time'
                    },
                    columnDefs: [
                        { orderable: false, targets: 7 },
                        {responsivePriority: 1, targets: 0},
                        {responsivePriority: 2, targets: -1}
                    ],
                    columns: [
                        null,
                        null,
                        null,
                        null,
                        null,
                        null,
                        {orderSequence: ['', 'desc', 'asc']},
                        null
                    ],
                    layout: {
                    topStart: null,
                    topEnd: null,
                    top: 'search'
                    }
                });
            </script>
        </div>
    </main>
</body>
</html>