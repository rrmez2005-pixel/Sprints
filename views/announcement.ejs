<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trades Job Board Announcements</title>
    <link rel="stylesheet" href="/styles/announcestyle.css">
</head>
<body>
    <main>
        <h1>Announcements</h1>
        <div id="nav">
            <a href="/">Home</a>
        </div>
        <div id="main">
            <% jobs.forEach(job => { %>
            <div class="job-announcement">
                <h2>Job for <%= job.company %> posted <%= formatDate(job.dateposted)%></h2>
                <p><%= job.location %></p>
                <p><%= job.message %></p>
                <a href="<%= job.applink %>">apply here</a>
            </div>
            <% }); %>
        </div>
    </main>
</body>
</html>