<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GRC Trades Job Board Announcements</title>
    <link rel="stylesheet" href="styles/hamburger.css">
    <script src="scripts/script.js" defer></script>
    <link rel="stylesheet" href="/styles/announcestyle.css">
    <link rel="icon" href="/images/GRC.png">

    <!--top hamburger menu-->
    <button class="hamburger" onclick="toggleSidebar()">☰</button>

    <div class="sidebar" id="sidebar">
        <a href="https://www.greenriver.edu/index.html">
            <img id="GRCimage" src="/images/GRC.png" alt="Green River College Logo">
        </a>
        <a href="/">Home</a>
        <a href="">Sign in</a>
        <a href="">Sign out</a>
        <a href="/jobs">Job board</a>
        <a href="/announcements">Announcements</a>
        <a href="https://www.greenriver.edu/students/student-support-and-services/index.html">Help</a>
    </div>

    <div class="overlay" id="overlay" onclick="closeSidebar()"></div>
    
</head>
<body>
    <main>
        <h1>Announcements</h1>
        <div id="nav">
            <a href="/">Home</a>
        </div>
        <div id="main">
            <% jobs.forEach(job => { %>
            <div class="job-announcement">
                <h2>Job for <%= job.company %> posted <%= formatDate(job.dateposted)%></h2>
                <p><%= job.location %></p>
                <p><%= job.message %></p>
                <a href="<%= job.applink %>">apply here</a>
            </div>
            <% }); %>
        </div>
    </main>
</body>
</html>