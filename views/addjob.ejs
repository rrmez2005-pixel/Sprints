<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Job</title>
    <link rel="stylesheet" href="styles/hamburger.css">
    <script src="scripts/script.js" defer></script>
    
    <link rel="stylesheet" href="styles/addjobstyles.css">
    <script src="/scripts/job.js" defer></script>

    

    <link rel="icon" href="images/job.png">

    <!--top hamburger menu-->
    <button class="hamburger" onclick="toggleSidebar()">☰</button>

    <div class="sidebar" id="sidebar">
        <a href="https://www.greenriver.edu/index.html">
            <img id="GRCimage" src="/images/GRC.png" alt="Green River College Logo">
        </a>
        <a href="">Sign in</a>
        <a href="">Sign out</a>
        <a href="/jobs">Job board</a>
        <a href="/announcements">Announcements</a>
        <a href="https://www.greenriver.edu/students/student-support-and-services/index.html">Help</a>
    </div>

    <div class="overlay" id="overlay" onclick="closeSidebar()"></div>
    
</head>
<body>
    <main>
        <div id="main">
            <h1>Add a job</h1>
            <form id="jobform" action="/submit-job" method="post" novalidate>
                <fieldset id="titlefield">
                    <label for="jobtitle">Job Title
                        <input type="text" id="jobtitle" name="jobtitle">
                    </label>
                    <span class="err" id="err-title">Please enter a job title</span>
                    <label for="company"> Company
                        <input type="text" id="company" name="company"> 
                    </label>
                    <span class="err" id="err-company">Please enter a company name</span>
                </fieldset>
                <fieldset id="employmentfield">
                    <legend>Employment</legend>
                    <label>
                        <input type="radio" id="fulltime" name="employment" value="full"> Full time
                    </label>
                    <label>
                        <input type="radio" id="parttime" name="employment" value="part"> Part time
                    </label>
                    <label>
                        <input type="radio" id="other" name="employment" value="other"> Other
                    </label>
                    <div id="otherfield">
                        <input type="text" id="othertext" placeholder="Other please specify">
                    </div>
                    <span class="err" id="err-employment"> Please select an employment type</span>
                </fieldset>
                <fieldset id="tradefield">
                    <label for="trade"> Trade
                        <select id="trade" name="trade">
                            <option value="none"> - Select Trade -</option>
                            <option value="automotive">Automotive</option>
                            <option value="carpentry">Carpentry</option>
                            <option value="manufacturing">Manufacturing</option>
                            <option value="mechatronics">Mechatronics</option>
                            <option value="welding">Welding</option>
                        </select>
                    </label>
                    <span class="err" id="err-trade">Please select a trade</span>
                    <label for="applink">Link to application
                        <input type="url" id="applink" name="applink">
                    </label>
                    <span class="err" id="err-link">Please input a proper link</span>
                </fieldset>
                <fieldset id="datelocation">
                    <label for="location"> Location
                        <input type="text" id="location" name="location">
                    </label>
                    <span class="err" id="err-location">Please enter a location</span>
                    <div id="datefield">
                        <label for="dateposted" id="posted-label">Date posted
                            <input type="date" name="dateposted" id="dateposted">
                        </label>
                        <span class="err" id="err-dateposted">Please enter a posted date</span>
                        <label for="dateexpires"> Date expires
                            <input type="date" name="dateexpires" id="dateexpires">
                        </label>
                        <span class="err" id="err-dateexpired">Please enter an expiration date</span>
                    </div>
                </fieldset>
                <fieldset id="announcement-field">
                    <label for="announcement">
                        <input type="checkbox" id="announcement"> Make announcement with post
                    </label>
                    <label for="message" id="announcement-label">Announcement</label>
                    <span class="err" id="message-err"> Please add a message to create an announcement</span>
                    <textarea id="message" name="message"></textarea>
                </fieldset>
                <button type="submit" id="postjob">Post Job</button>
            </form>
        </div>
    </main>
</body>
</html>