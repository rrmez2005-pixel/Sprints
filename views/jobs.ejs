<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GRC Trades Jobs</title>
    <link rel="stylesheet" href="styles/styles.css">
    <link rel="stylesheet" href="styles/hamburger.css">
    <script src="scripts/script.js" defer></script>

    <!-- DataTable -->
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://cdn.datatables.net/3.1.4/js/dataTables.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/3.1.4/css/dataTables.dataTables.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/4.1.1/css/responsive.dataTables.min.css">
    <script src="https://cdn.datatables.net/responsive/4.1.1/js/dataTables.responsive.min.js"></script>
    <!-- Favicon -->
     <link rel="icon" href="/images/GRC.png">
    
</head>
<body>

    <!--top hamburger menu-->
    <button class="hamburger" onclick="toggleSidebar()">☰</button>

    <div class="sidebar" id="sidebar">
        <a href="https://www.greenriver.edu/index.html">
            <img id="GRCimage" src="/images/GRC.png" alt="Green River College Logo">
        </a>
        <a href="/">Home</a>
        <a href="">Sign in</a>
        <a href="">Sign out</a>
        <a href="/jobs">Job board</a>
        <a href="/announcements">Announcements</a>
        <a href="https://www.greenriver.edu/students/student-support-and-services/index.html">Help</a>
    </div>

    <div class="overlay" id="overlay" onclick="closeSidebar()"></div>

    <h1>Job Board</h1>
    <main>
        <div id="main">
            <!-- Job data table goes here -->
             <div class="table-wrap">
                <table id="jobtable">
                    <thead>
                        <tr>
                            <th>Job Title</th>
                            <th>Company</th>
                            <th>Job Type</th>
                            <th>Employment</th>
                            <th>Trade</th>
                            <th>Location</th>
                            <th>Date Posted</th>
                            <th>Date Expires</th>
                            <th>Apply</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% jobs.forEach(job => { %>
                        <tr>
                            <td><%= job.jobtitle %></td>
                            <td><%= job.company %></td>
                            <td><%= job.job %></td>
                            <td><%= job.employment %></td>
                            <td><%= job.trade %></td>
                            <td><%= job.location %></td>
                            <td><%= formatDate(job.dateposted) %></td>
                            <td><%= formatDate(job.dateexpires) %></td>
                            <td>
                                <!-- Dynamic EJS link using what the user typed -->
                                <a href="<%= job.applink %>" target="_blank" class="apply">Apply</a>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
             </div>
             <script>
                new DataTable('#jobtable', {
                    responsive:true,

                    language: {
                        emptyTable: 'No jobs available at this time'
                    },
                    columnDefs: [
                        { orderable: false, targets: 7}
                    ]
                });
             </script>
        </div>
    </main>
</body>
</html>