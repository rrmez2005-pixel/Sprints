<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GRC Trades Job Added Confirmation</title>
  <link rel="stylesheet" href="styles/hamburger.css">
  <link rel="stylesheet" href="styles/confirm.css">
  <link rel="icon" href="/images/GRC.png">
  <script src="scripts/script.js" defer></script>
</head>
<body>

  <!--top hamburger menu-->
    <button class="hamburger" onclick="toggleSidebar()">☰</button>

    <div class="sidebar" id="sidebar">
        <a href="https://www.greenriver.edu/index.html">
            <img id="GRCimage" src="/images/GRC.png" alt="Green River College Logo">
        </a>
        <a href="/">Home</a>
        <a href="">Sign in</a>
        <a href="">Sign out</a>
        <a href="/jobs">Job board</a>
        <!-- <a href="/announcements">Announcements</a> -->
        <a href="https://www.greenriver.edu/students/student-support-and-services/index.html">Help</a>
    </div>

    <div class="overlay" id="overlay" onclick="closeSidebar()"></div>

  <h1>Confirmed - Job info below ▽</h1>

  <h2>Job info: </h2>

  <p>Job Title: <%= job.jobtitle %></p>
  <p>Company: <%= job.company %></p>
  <p>Job Type: <%= job.job %></p>
  <p>Employment: <%= job.employment %></p>
  <p>Trade: <%= job.trade %></p>
  <p>Location: <%= job.location %></p>
  <p>Date Posted: <%= job.dateposted %></p>
  <p>Date Expires: <%= job.dateexpires %></p>
  <p>Application Link: <a href="<%= job.applink %>" target="_blank" class="apply"><%= job.applink %></a></p>
  <p>Timestamp: <%= job.timestamp.toLocaleString() %></p>


  <div id="navigation">
    <a href="/add-job">Add another job</a>
    <a href="/">Go home</a>
    <a href="/jobs">Check the table</a>
    <!-- <a href="/announcements">View announcements</a> -->
  </div>
</body>
</html>